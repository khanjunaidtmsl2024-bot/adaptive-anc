# ==============================================================================
# PS 26052 — Adaptive ANC (.gitignore)
# ==============================================================================

# --- Python Bytecode & Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Archives & Large Compressed Backups ---
*.zip
*.tar
*.tar.gz
*.7z
*.rar
Adaptive ANC (2).zip
Adaptive ANC.zip

# --- Large PDF Files (>50MB / GitHub 100MB Limit) ---
# Filter-combined.pdf is ~102.5 MB (strictly blocked by GitHub push limit)
# All research papers 0-42_merged.pdf is ~78.8 MB (individual papers preserved)
**/Filter-combined.pdf
**/All research papers 0-42_merged.pdf

# --- Audio Waveforms & Heavy Binary Datasets ---
# Keep directory structure via .gitkeep, but ignore generated audio
*.wav
*.flac
*.mp3
*.ogg
*.raw
*.pcm

# Whitelist lightweight, curated demonstration samples (<100KB each)
!data/samples/*.wav
!data/samples/.gitkeep
# Canonical test speech used by the laptop-validation CI gates (94 KB): CI
# must exercise the SAME input as local dev, or the synthetic fallback path
# (STOI ~0.44) makes the honest 0.70/0.60 gates red in CI only.
!data/v4/clean/SPK_001_clean.wav

# --- Checkpoints & Model Weights (>50MB) ---
*.pth
*.pt
*.onnx
*.bin
*.ckpt
*.h5
*.pb

# Whitelist canonical baseline checkpoint for evaluation gates (42 KB)
!checkpoints/tiny_enhancer_v3.pt


# --- Scratch & Temporary Analysis ---
scratch/
transfer_sections.txt

# --- Editor & OS Artefacts ---
.freebuff/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
